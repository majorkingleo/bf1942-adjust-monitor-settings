{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make",
            "detail": "Build the project with GNU make in a Cygwin shell",
            "type": "shell",
            "command": "cd '${workspaceFolder}' && make",
            "options": {
                "shell": {
                    "executable": "C:\\cygwin64\\bin\\bash.exe",
                    "args": [
                        "-lc"
                    ]
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "make clean",
            "detail": "Remove build output",
            "type": "shell",
            "command": "cd '${workspaceFolder}' && make clean",
            "options": {
                "shell": {
                    "executable": "C:\\cygwin64\\bin\\bash.exe",
                    "args": [
                        "-lc"
                    ]
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "make check",
            "detail": "Build and run the test suite (tests/golden + tests/data fixtures)",
            "type": "shell",
            "command": "cd '${workspaceFolder}' && make check",
            "options": {
                "shell": {
                    "executable": "C:\\cygwin64\\bin\\bash.exe",
                    "args": [
                        "-lc"
                    ]
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "reconfigure",
            "detail": "Regenerate the build system and re-run configure (reconfigure.sh)",
            "type": "shell",
            "command": "cd '${workspaceFolder}' && ./reconfigure.sh",
            "options": {
                "shell": {
                    "executable": "C:\\cygwin64\\bin\\bash.exe",
                    "args": [
                        "-lc"
                    ]
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "make -j",
            "detail": "Parallel build using all available cores",
            "type": "shell",
            "command": "cd '${workspaceFolder}' && make -j\"$(nproc)\"",
            "options": {
                "shell": {
                    "executable": "C:\\cygwin64\\bin\\bash.exe",
                    "args": [
                        "-lc"
                    ]
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "deploy rfa tools",
            "detail": "Build, strip and install rfaPack/rfaUnpack into E:\\progs\\bf_pablov_mod\\bin (backs up the 2004 originals as *.orig.exe)",
            "type": "shell",
            "command": "${workspaceFolder}\\tools\\deploy_rfa_tools.ps1",
            "options": {
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-File"
                    ]
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "verify deployed rfa tools",
            "detail": "Run the consumer repository's own check on the deployed rfaPack/rfaUnpack, comparing against the 2004 originals on a real archive",
            "type": "shell",
            "command": "& 'E:\\progs\\bf_pablov_mod\\.github\\skills\\rfa-pack-unpack\\scripts\\Test-RfaTools.ps1' -Archive 'origin\\Mods\\FH\\Archives\\bf1942\\levels\\Nuenen-1944.rfa'",
            "options": {
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-Command"
                    ]
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "rebuild",
            "detail": "Clean then build",
            "dependsOrder": "sequence",
            "dependsOn": [
                "make clean",
                "make"
            ],
            "problemMatcher": [],
            "group": "build"
        }
    ]
}
