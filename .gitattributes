# Shell scripts are executed by Cygwin bash and must keep LF line endings.
# A CRLF checkout breaks them with "$'\r': command not found" / "unexpected end of file".
*.sh text eol=lf

# Autotools inputs must be LF as well. With CRLF, the AC_CONFIG_FILES entry in
# configure.ac becomes "Makefile\r" and config.status aborts with
# "cannot find input file" - and the stray CR overwrites the error text in the
# terminal, which makes it very hard to read.
*.ac text eol=lf
*.am text eol=lf

# Vendored third-party sources are kept byte-identical to upstream, so pin their
# endings too - a CRLF checkout would silently "modify" them.
third_party/** text eol=lf

# The golden writer fixture tree MUST stay byte-identical to what the committed
# oracle archives were built from. Two of its files are deliberately CRLF, and the
# archives capture their sizes, so any line-ending conversion breaks the byte
# comparison. With core.autocrlf=input (set on this machine) git silently stripped
# the CR on commit, which made our writer look 2 bytes short - hence -text, which
# disables all conversion in both directions.
tests/data/golden/tree/** -text
